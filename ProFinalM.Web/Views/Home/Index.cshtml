@section Scripts {
    <script>
        window.numericData = {
            taylor: @Html.Raw(JsonSerializer.Serialize(new
            {
                real = Model.TaylorResult?.RealCurve,
                approx = Model.TaylorResult?.TaylorCurve
            }, jsonOptions)),
            leastSquares: @Html.Raw(JsonSerializer.Serialize(new
            {
                points = Model.LeastSquaresResult?.Points,
                line = Model.LeastSquaresResult?.Line
            }, jsonOptions))
        };
    </script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
}
